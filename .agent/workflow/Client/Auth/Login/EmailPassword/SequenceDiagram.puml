@startuml Login with Email / Password
title Login with Email / Password

actor User
boundary "Client App\n(Web/Mobile)" as Client
control AuthController
control AuthService
control UserService
database "User Collection" as UserDB
control "OTP Service" as OTPService
collections "Redis / Cache\n(Optional)" as Cache
control "Email Service" as EmailService
control JwtService

== Mở màn hình đăng nhập ==
User -> Client: Mở màn hình đăng nhập
Client --> User: Hiển thị form email + password

== Gửi request đăng nhập ==
User -> Client: Nhập email, password\nvà bấm Đăng nhập
Client -> AuthController: POST /auth/login\n{ email, password }
activate AuthController

AuthController -> AuthService: login(email, password)
activate AuthService

' Bước 1: Tìm user
AuthService -> UserService: findByEmailWithPassword(email)
activate UserService
UserService -> UserDB: findOne({ email })\n.select("+password")
note right: select("+password") vì\nfield này có select: false
UserDB --> UserService: user / null
UserService --> AuthService: user / null
deactivate UserService

' Bước 2: Kiểm tra user tồn tại
alt User không tồn tại
    AuthService --> AuthController: throw INVALID_CREDENTIALS
    AuthController --> Client: 401 Unauthorized\n"Email hoặc mật khẩu không đúng"
    Client --> User: Hiển thị lỗi
else User tồn tại
    ' Bước 3: So sánh password
    AuthService -> AuthService: bcrypt.compare(password, user.password)

    alt Password không khớp
        AuthService --> AuthController: throw INVALID_CREDENTIALS
        AuthController --> Client: 401 Unauthorized\n"Email hoặc mật khẩu không đúng"
        Client --> User: Hiển thị lỗi
    else Password đúng
        ' Bước 4: Kiểm tra đã verify chưa
        alt isVerified = false
            ' Hệ thống tự tạo và gửi lại OTP (không cần user bấm nút)
            AuthService -> AuthService: generateOTP()
            AuthService -> AuthService: hashOTP(otp)
            AuthService -> AuthService: calculateOtpExpiry()

            AuthService -> UserService: updateOTP(userId, hashedOtp, otpExpires)
            activate UserService
            UserService -> UserDB: updateOne({ _id: userId },\n{ otp: hashedOtp, otpExpires })
            UserDB --> UserService: OK
            UserService --> AuthService: OK
            deactivate UserService

            opt Lưu OTP vào cache
                AuthService -> Cache: set(email, hashedOtp, expiry)
                Cache --> AuthService: OK
            end

            AuthService -> OTPService: sendVerificationCode(email, otp)
            activate OTPService
            OTPService -> EmailService: sendMail(email, otp)
            activate EmailService
            EmailService --> OTPService: sent
            deactivate EmailService
            OTPService --> AuthService: success
            deactivate OTPService

            AuthService --> AuthController: throw EMAIL_NOT_VERIFIED_WITH_NEW_OTP
            AuthController --> Client: 403 Forbidden\n"Tài khoản chưa xác thực. Mã OTP mới đã được gửi đến email của bạn."
            Client --> User: Hiển thị lỗi + hướng dẫn kiểm tra email để nhập OTP
        else isVerified = true
            ' Bước 5: Sinh tokens
            AuthService -> JwtService: generateAccessToken(userId, role)
            JwtService --> AuthService: accessToken (15m)

            AuthService -> JwtService: generateRefreshToken(userId)
            JwtService --> AuthService: refreshToken (7d)

            ' Bước 6: Cập nhật lastActiveAt
            AuthService -> UserService: updateLastActive(userId)
            activate UserService
            UserService -> UserDB: updateOne({ lastActiveAt: now() })
            UserDB --> UserService: OK
            UserService --> AuthService: OK
            deactivate UserService

            AuthService --> AuthController: { accessToken, refreshToken, user }
            AuthController --> Client: 200 OK\n{ accessToken, refreshToken,\n  user: { _id, fullName, email,\n  role, subscription, isPremium } }
            Client -> Client: Lưu tokens vào memory/secure storage
            Client --> User: Đăng nhập thành công\nChuyển hướng về Home
        end
    end
end

deactivate AuthService
deactivate AuthController
@enduml