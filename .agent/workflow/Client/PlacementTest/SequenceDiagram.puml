@startuml SmartPlacementTest_FullFlow
skinparam backgroundColor #FAFAFA
skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam ParticipantPadding 20
skinparam BoxPadding 12

title UniLish — Smart Placement Test: Full Sequence Diagram

actor User
participant "PlacementTestIntroModal\n(Client)" as Modal
participant "ListeningReading\nPage (Client)" as LR
participant "Writing\nPage (Client)" as Writing
participant "Speaking\nPage (Client)" as Speaking
participant "Result\nPage (Client)" as Result

box "Zustand Stores" #EEF2FF
    participant "placement-test.store\n(sessionStorage)" as PTStore
end box

box "Server — Express API" #F0FFF4
    participant "Placement\nSession Controller" as SessionCtrl
    participant "Placement\nTest Controller" as PTCtrl
    participant "Speaking\nController" as SpkCtrl
end box

box "Data Layer" #FFF8E1
    database "MongoDB" as Mongo
    database "Redis\n(BullMQ)" as Redis
end box

box "AI Services" #FFF0F0
    participant "gpt-5.4-mini" as GPT
    participant "OpenAI TTS" as TTS
    participant "Azure AI Speech\n(STT + Pronunciation)" as Azure
end box

'══════════════════════════════════════
' STEP 0: INTRO & SESSION INIT
'══════════════════════════════════════
== [ STEP 0 ] Intro & Session Initialization ==

User -> Modal : Mo trang kiem tra dau vao
Modal -> PTCtrl : GET /placement-tests/runtime/active?language=en
PTCtrl -> Mongo : findOne({ status: 'active', language })
Mongo --> PTCtrl : ActivePlacementTest { _id, modules }
PTCtrl --> Modal : 200 { placementTestId }

User -> Modal : Nhan "Bat dau lam bai"
Modal -> PTCtrl : POST /placement-tests/:id/attempts
PTCtrl -> Mongo : create PlacementAttempt { userId, testId, expiresAt }
Mongo --> PTCtrl : { attemptId, answerSheet[], expiresAt }
PTCtrl --> Modal : 201 { attemptId }

Modal -> SessionCtrl : POST /placement-sessions\n{ lrAttemptId: attemptId }
SessionCtrl -> Mongo : create PlacementSession { userId, lrAttemptId, status: 'in_progress' }
Mongo --> SessionCtrl : { sessionId }
SessionCtrl --> Modal : 201 { sessionId }

Modal -> PTStore : setSession(sessionId)\nsetAttemptId(attemptId)\nsetCurrentModule('lr')
Modal --> LR : navigate('/placement-test/listening-reading')

'══════════════════════════════════════
' STEP 1: LISTENING & READING
'══════════════════════════════════════
== [ STEP 1 ] Listening & Reading Module (60 phut, MCQ) ==

LR -> PTCtrl : GET /placement-tests/runtime/active (re-validate)
LR -> LR : Load attempt tu createAttemptMutation

loop Auto-save (debounce 800ms)
    User -> LR : Chon dap an / Flag cau hoi
    LR -> LR : useAnswerState -> updateLocalMap
    LR -> PTCtrl : PATCH /placement-attempts/:attemptId/answers\n{ answers: [{ questionId, selectedOption, flagged }] }
    PTCtrl -> Mongo : bulkWrite answerSheet
    Mongo --> PTCtrl : 200 OK
    PTCtrl --> LR : 200 { saved: true }
end

User -> LR : Nhan "Nop bai" (hoac het gio -> auto-submit)
LR -> LR : cancelScheduledSaves()\nflushPendingChanges()
LR -> PTCtrl : POST /placement-attempts/:attemptId/submit
PTCtrl -> Mongo : update status='submitted', compute lrRawScore
Mongo --> PTCtrl : { lrRawScore, totalQuestions, durationSeconds }
PTCtrl -> SessionCtrl : internal: updateSession(sessionId, { lrRawScore })
PTCtrl --> LR : 200 { attempt: { lrRawScore, durationSeconds, ... } }

LR -> PTStore : setLrScore(lrRawScore)\nsetCurrentModule('writing')
LR --> User : SubmissionSuccessCard (overlay)
User -> LR : Nhan "Tiep tuc phan Writing"
LR --> Writing : navigate('/placement-test/writing')

'══════════════════════════════════════
' STEP 2: WRITING
'══════════════════════════════════════
== [ STEP 2 ] Writing Module (30 phut, Free-text) ==

Writing -> PTStore : read { sessionId, lrScore }
Writing -> SessionCtrl : POST /placement-sessions/:sessionId/writing/start\n{ lrScore }
note right of SessionCtrl
  Adaptive Prompt Logic:
  lrScore < 45% -> A2 topic
  lrScore 45-75% -> B1/B2 topic
  lrScore > 75% -> C1 topic
end note
SessionCtrl -> GPT : generatePrompt(level, topicPool)
GPT --> SessionCtrl : { prompt, timeLimitMinutes: 30 }
SessionCtrl -> Mongo : create WritingAttempt { sessionId, prompt, expiresAt }
Mongo --> SessionCtrl : { writingAttemptId }
SessionCtrl --> Writing : 201 { writingAttemptId, prompt, timeLimitMinutes }

Writing -> PTStore : setWritingAttemptId(writingAttemptId)
Writing -> Writing : Start countdown timer (1800s)
Writing -> Writing : Show prompt + textarea

loop Real-time feedback
    User -> Writing : Typing essay text
    Writing -> Writing : updateWordCount() real-time
end

User -> Writing : Nhan "Nop bai" (hoac timer = 0 -> auto-submit)
Writing -> Writing : Validate wordCount >= 150
Writing -> SessionCtrl : POST /placement-sessions/:sessionId/writing/submit\n{ writingAttemptId, essay, wordCount, durationSeconds }
SessionCtrl -> Mongo : update WritingAttempt { essay, status: 'submitted' }
SessionCtrl -> Redis : enqueue writing-grading-job\n{ writingAttemptId, essay, prompt }
Mongo --> SessionCtrl : OK
Redis --> SessionCtrl : { jobId }
SessionCtrl --> Writing : 202 { jobId, status: 'grading' }

note over Redis, GPT
  === BullMQ Background Worker ===
  writing-grading.worker.ts:
  1. Dequeue job
  2. Call gpt-4o-mini with 4 criteria (TR, CC, LR, GRA)
  3. Store band scores in MongoDB
  4. Update PlacementSession.writingBand
end note

Redis -> GPT : Analyze essay (TR 25% + CC 25% + LR 25% + GRA 25%)
GPT --> Redis : { TR: 5.5, CC: 6.0, LR: 5.0, GRA: 5.5, feedback: {...} }
Redis -> Mongo : update WritingAttempt { scores, status: 'done' }

Writing --> User : SubmissionSuccessCard
User -> Writing : Nhan "Tiep tuc phan Speaking"
Writing --> Speaking : navigate('/placement-test/speaking')

'══════════════════════════════════════
' STEP 3: SPEAKING
'══════════════════════════════════════
== [ STEP 3 ] Speaking Module (~15 phut, AI Examiner) ==

Speaking -> PTStore : read { sessionId }
Speaking -> SpkCtrl : POST /placement-sessions/:sessionId/speaking/start
SpkCtrl -> GPT : generate(part1Questions x 4, cueCard, part3Questions x 2)
GPT --> SpkCtrl : { part1Qs, cueCard, part3Qs }
SpkCtrl -> Mongo : create SpeakingAttempt { sessionId, questions, cueCard }
Mongo --> SpkCtrl : { speakingAttemptId }
SpkCtrl --> Speaking : 201 { speakingAttemptId, part1Qs, cueCard, part3Qs }

Speaking -> PTStore : setSpeakingAttemptId(speakingAttemptId)

User -> Speaking : screen="intro" -> Nhan "Bat dau"
Speaking --> User : screen="test-mic"

User -> Speaking : TestMic: nhan "Cho phep mic"
Speaking -> Speaking : navigator.mediaDevices.getUserMedia({ audio: true })
Speaking --> User : Mic OK -> screen="test-main"

Speaking -> SpkCtrl : GET /speaking/examiner-voice\n{ text: part1Qs[0] }
SpkCtrl -> TTS : synthesize(text, voice='alloy')
TTS --> SpkCtrl : audio stream
SpkCtrl --> Speaking : audio stream
Speaking --> User : AI Examiner phat cau hoi Part 1

loop Part 1 — 4 cau hoi (moi cau ~35s)
    User -> Speaking : Ghi am cau tra loi
    Speaking -> Azure : stream audio chunk
    Azure --> Speaking : STT transcript + PronunciationScore (real-time)
    Speaking -> SpkCtrl : POST /speaking/audio-chunk\n{ speakingAttemptId, part: 1, questionIdx, audioBlob }
    SpkCtrl -> Mongo : append transcript + pronunciation data
    Speaking --> User : Show live transcript
    Speaking -> SpkCtrl : GET /speaking/examiner-voice (cau tiep theo)
    SpkCtrl -> TTS : synthesize(nextQuestion)
    TTS --> SpkCtrl : audio
    SpkCtrl --> Speaking : audio
end

Speaking --> User : Intro Part 2\n(1 phut thinking, 2 phut speaking)
User -> Speaking : Nhan "Start now"

Speaking -> SpkCtrl : GET /speaking/examiner-voice\n{ text: "Here is your cue card..." + cueCard }
SpkCtrl -> TTS : synthesize(cueCardIntro)
TTS --> SpkCtrl : audio
SpkCtrl --> Speaking : audio
Speaking --> User : AI doc cue card

note over Speaking : Thinking time: 60s countdown\nSpeaking time: 120s countdown

User -> Speaking : Ghi am Part 2 (1-2 phut)
Speaking -> Azure : stream audio
Azure --> Speaking : STT transcript + PronunciationScore
Speaking -> SpkCtrl : POST /speaking/audio-chunk\n{ part: 2, audioBlob }

Speaking --> User : Intro Part 3
loop Part 3 — 2 cau hoi
    Speaking -> SpkCtrl : GET /speaking/examiner-voice (Part 3 question)
    SpkCtrl -> TTS : synthesize
    TTS --> SpkCtrl : audio
    SpkCtrl --> Speaking : audio
    Speaking --> User : AI Examiner hoi Part 3
    User -> Speaking : Ghi am cau tra loi
    Speaking -> Azure : stream audio
    Azure --> Speaking : STT + Pronunciation data
    Speaking -> SpkCtrl : POST /speaking/audio-chunk\n{ part: 3, questionIdx, audioBlob }
end

Speaking -> SpkCtrl : POST /placement-sessions/:sessionId/speaking/submit\n{ speakingAttemptId }
SpkCtrl -> Mongo : update SpeakingAttempt { status: 'submitted' }
SpkCtrl -> Redis : enqueue speaking-grading-job\n{ speakingAttemptId, transcripts, pronunciationData }
SpkCtrl --> Speaking : 202 { status: 'grading' }

note over Redis, GPT
  === BullMQ Background Worker ===
  speaking-grading.worker.ts:
  1. Aggregate Azure pronunciation scores
     -> Pronunciation band (AccuracyScore, FluencyScore, WPM)
  2. Call gpt-4o-mini with full transcript
     -> Fluency/Coherence, Lexical Resource, GRA bands
  3. Average 4 criteria -> Speaking overall band
  4. Store in MongoDB
  5. Update PlacementSession.speakingBand
  6. Trigger computeFinalResult()
end note

Redis -> Azure : Aggregate pronunciation metrics
Azure --> Redis : { pronunciation: 6.5, fluency: 85 WPM }
Redis -> GPT : Analyze transcript (Fluency, Lexical, GRA)
GPT --> Redis : { fluency: 6.0, lexical: 6.0, GRA: 5.5, feedback: {...} }
Redis -> Mongo : update SpeakingAttempt { bands, feedback, status: 'done' }
Redis -> Mongo : computeFinalResult()\nCEFR = weighted_avg(LR x 0.4 + W x 0.3 + S x 0.3)
Mongo --> Redis : { cefr: 'B2', ... }
Redis -> Mongo : update PlacementSession { cefrFinal: 'B2', status: 'completed' }

Speaking --> User : SubmissionSuccessCard
User -> Speaking : Nhan "Tiep tuc"
Speaking --> Result : navigate('/placement-test/result')

'══════════════════════════════════════
' STEP 4: RESULT DASHBOARD
'══════════════════════════════════════
== [ STEP 4 ] Result Dashboard ==

Result -> PTStore : read { sessionId }

loop Poll moi 5 giay (toi da 5 phut)
    Result -> SessionCtrl : GET /placement-sessions/:sessionId/result
    SessionCtrl -> Mongo : findOne({ _id: sessionId })
    Mongo --> SessionCtrl : PlacementSession

    alt status != 'completed'
        SessionCtrl --> Result : 202 { status: 'computing' }
        Result --> User : "AI dang tong hop ket qua..."
    else status = 'completed'
        SessionCtrl --> Result : 200 {\n  cefr, scores: { L, R, W, S },\n  feedback: { writing, speaking }\n}
        Result -> Result : Stop polling
    end
end

Result --> User : Render Result Dashboard:\n  - Spider (Radar) Chart 4 ky nang\n  - CEFR Level Card (B2)\n  - Skill Breakdown bars\n  - AI Feedback Accordion (Writing + Speaking)

User -> Result : Nhan "Bat dau lo trinh hoc"
Result -> PTStore : clear()
Result --> User : navigate('/dashboard/roadmap')

@enduml