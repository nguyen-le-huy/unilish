# ============================================
# UNILISH SERVER - ENVIRONMENT VARIABLES
# ============================================

# --- SERVER CONFIG ---
NODE_ENV=development
PORT=5000
SERVER_URL=http://localhost:5432
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# --- DATABASES (POLYGLOT) ---
# 1. MongoDB (Operational Source of Truth)
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/unilish?retryWrites=true&w=majority

# 2. Redis (Cache/Queue - Optional for Dev)
REDIS_URI=redis://localhost:6379

# 3. Pinecone (Vector Database for Semantic Search)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east1-gcp
PINECONE_INDEX_NAME=unilish-knowledge
PINECONE_COURSE_INDEX_NAME=unilish-course-series

# 4. OpenAI (For Embeddings & AI Features)
OPENAI_API_KEY=your-openai-api-key

# --- AUTHENTICATION ---
# JWT Strategy
JWT_SECRET=super-secret-key-change-me
JWT_EXPIRES_IN=7d

# Session (Express Session)
SESSION_SECRET=session-secret-change-me

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Optional: set explicitly in production to avoid redirect_uri mismatch.
# Example: https://api-unilish.devenir.shop/api/auth/google/callback
GOOGLE_CALLBACK_URL=

# --- CLOUD STORAGE ---
# Cloudinary (Images/Avatar)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Cloudflare R2 (Heavy Media: Audio/Video)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=your-bucket

# --- INTEGRATIONS & WEBHOOKS ---
# N8N (Email Service/Workflows)
N8N_WEBHOOK_URL=https://n8n.your-domain.com/webhook/...

# --- GLOBAL QUOTA LIMITS (non-commercial abuse protection) ---
# All users share the same daily limits for expensive AI features.
# Set to -1 for unlimited. Defaults: AI_CHAT=50, AI_SPEAKING=20, UNIT_ACCESS=3
# GLOBAL_LIMIT_AI_CHAT_DAILY=50
# GLOBAL_LIMIT_AI_SPEAKING_DAILY=20
# GLOBAL_LIMIT_UNIT_ACCESS=3